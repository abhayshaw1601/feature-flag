# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL and Prisma
DATABASE_URL=postgresql://flagforge:flagforge@localhost:5432/flagforge?schema=public
DIRECT_URL=postgresql://flagforge:flagforge@localhost:5432/flagforge?schema=public

# Auth.js (Phase 1)
AUTH_SECRET=replace-with-a-long-random-value
AUTH_GITHUB_ID=replace-with-github-oauth-client-id
AUTH_GITHUB_SECRET=replace-with-github-oauth-client-secret

# AI provider (Phase 4+)
AI_PROVIDER=google
GEMINI_API_KEY=replace-with-gemini-api-key
LLM_MODEL_REASONING=gemini-2.5-pro
LLM_MODEL_FAST=gemini-2.5-flash

# Phase 6: uncached live assessments per workspace per UTC day (process-local)
AI_WORKSPACE_DAILY_BUDGET=200

# GitHub App (Phase 7+)
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_PRIVATE_KEY=replace-with-github-app-private-key
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret

# Set true to use deterministic AI fixtures during local development
AI_MOCK=true
