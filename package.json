{
  "name": "flagforge",
  "version": "0.1.0",
  "private": true,
  "description": "FlagForge feature flag control plane foundation",
  "workspaces": [
    "packages/contracts",
    "packages/evaluator",
    "packages/sdk",
    "examples/next-app"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run contracts:build && npm run sdk:build && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "contracts:build": "tsc -p packages/contracts/tsconfig.json",
    "db:generate": "prisma generate",
    "db:validate": "node scripts/db-validate.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "test": "npm run test:smoke && npm run test:phase2 && npm run test:phase3 && npm run test:rollout-risk && npm run contracts:build && npm run db:validate && npm run typecheck && npm run lint && npm run format:check",
    "test:phase2": "tsx --test tests/phase2-backend.ts tests/phase2-ui.ts",
    "test:smoke": "tsx tests/phase0-smoke.ts",
    "test:rollout-risk": "tsx --test tests/rollout-risk*.ts",
    "db:verify": "tsx prisma/verify-seed.ts",
    "test:phase3": "npm run sdk:build && tsx --test tests/evaluator.test.ts tests/sdk.test.ts tests/sdk-delivery.test.ts tests/example-smoke.test.ts",
    "sdk:build": "tsc -p packages/evaluator/tsconfig.json && node packages/sdk/build.mjs",
    "sdk:benchmark": "tsx scripts/benchmark-evaluator.ts",
    "example:dev": "npm run sdk:build && npm run dev --workspace @flagforge/example"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@fontsource/inter": "5.1.1",
    "@fontsource/jetbrains-mono": "5.1.1",
    "@prisma/client": "6.14.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "15.5.6",
    "next-auth": "^5.0.0-beta.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.16.0",
    "eslint-config-next": "15.5.6",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "prisma": "6.14.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "esbuild": "0.23.1"
  }
}
