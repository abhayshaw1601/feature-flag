{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "incremental": false,
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"],
      "@flagforge/contracts": ["./packages/contracts/src/index.ts"]
    }
  },
  "include": [
    "../lib/auto-rollout/**/*.ts",
    "../components/auto-rollout/**/*.ts",
